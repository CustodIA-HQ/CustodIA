# The hedged key pair for the delegated x402 signer. This file is gitignored.
# Create the account at portal.hedera.com WITH EMAIL — the anonymous faucet
# creates a "hollow" account that cannot send. Copy this file to `.env`.
#
# HEDERA_CLIENT_ID and HEDERA_CLIENT_KEY never leave this directory: the agent
# process pipes the payment challenge in and reads the signature out.
HEDERA_CLIENT_ID=0.0.12345
HEDERA_CLIENT_KEY=
HEDERA_NETWORK=hedera:testnet