# ── AI provider (packages/agent) — OpenAI via the official `openai` SDK ──────
OPENAI_API_KEY=
# Optional: override the agent model (default gpt-5.6-luna, the cheapest tier).
# Use gpt-5.6-terra for a demo recording if rationale quality matters more.
OPENAI_MODEL=
# Optional: none | low | medium (API default) | high | xhigh | max.
# Luna function tools require "none"; Terra can use "low" for this loop.
OPENAI_REASONING_EFFORT=none

# ── The Graph (packages/graph, apps/risk-api) ────────────────────────────────
GRAPH_STUDIO_KEY=

# ── Database (packages/db) — Neon Postgres ───────────────────────────────────
DATABASE_URL=

# ── Sepolia / ENSv2 (packages/ens, apps/web) ─────────────────────────────────
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=custodia.eth
ENS_RESOLVER_ADDRESS=
ENS_OPERATOR_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# ── x402 risk service (apps/risk-api, apps/signer) ───────────────────────────
# Blocky402 facilitator. NEVER x402.org/facilitator — it fails the Hedera track.
FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet
# Receiving Hedera account (risk-api payTo). Format shard.realm.num, e.g. 0.0.12345
RISK_API_PAYTO=0.0.xxxxx
RISK_API_URL=http://localhost:8402
# Prototype budget — maximum HBAR the agent may spend per task via x402.
X402_MAX_HBAR_PER_TASK=1

# ── Wallet (apps/web) ────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
SESSION_SECRET=
# Public origin used in links sent to chat channels, e.g. https://custodia.example
APP_URL=

# ── Telegram channel (apps/web webhook, apps/worker delivery) ───────────────
# setWebhook with url=<APP_URL>/api/telegram and secret_token=TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (apps/web webhook, apps/worker delivery) ─────────────
# Webhook callback <APP_URL>/api/whatsapp, verify token WHATSAPP_VERIFY_TOKEN, field "messages".
# Use a permanent System User token, never the 24 h token from API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business number in international format, digits only (wa.me pairing link).
WHATSAPP_BUSINESS_NUMBER=
# App Settings > Basic > App Secret — verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Signer keys live in apps/signer/.env, never here: HEDERA_CLIENT_ID, HEDERA_CLIENT_KEY.
# Disabled watcher route: authorized calls return 501 until processing is implemented.
CRON_SECRET=

# ── TaskVault execution (apps/worker) ─────────────────────────────────────────
# Execution signer: the ONLY key allowed to call TaskVault.executeSwap. Needs Sepolia ETH for gas. Cannot withdraw.
EXECUTION_PRIVATE_KEY=
# Policy signer: approves one bounded action for 2 minutes. Never sends transactions, never holds funds.
POLICY_SIGNER_PRIVATE_KEY=
